// Molio – a végleges rendszer adatbázis-sémája (PostgreSQL), specifikáció v2.1, 8. fejezet (v2.0 + kezelési tételek, kódtáblák és szinonimák, javasolt kezelések, megrendelés-követés).
// Elvek: UUID kulcsok, időzóna-tudatos időbélyegek, létrehozási/módosítási idő minden táblán,
// klinikai adatoknál logikai törlés (deletedAt), szervezeti hierarchia: cég → telephely → rendelő.
// A nyilvános demó ezt a sémát nem használja (a böngészőben tárol), de a mintaadatai ugyanabból a seedből készülnek.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  fogorvos
  asszisztens
}

enum Dentition {
  primary
  permanent
}

enum AppointmentStatus {
  booked
  arrived
  in_progress
  done
  cancelled
  noshow
}

enum PerMode {
  visit
  tooth
  surface
}

enum MovementKind {
  receipt
  usage
  correction
}

enum ReminderChannel {
  sms
  email
}

enum ReminderStatus {
  none
  scheduled
  sent
  /// a páciens NEM-mel jelezte, hogy nem tud jönni (v2.1, 9. pont); a „megerősítve” állapot megszűnt
  cancelled
}

model Company {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  address   String
  phone     String
  email     String?
  sites     Site[]
  users     User[]
  patients  Patient[]
  synonyms  Synonym[]
  templates MessageTemplate[]
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz

  @@map("companies")
}

model Site {
  id          String         @id @default(uuid()) @db.Uuid
  companyId   String         @map("company_id") @db.Uuid
  company     Company        @relation(fields: [companyId], references: [id])
  name        String
  address     String
  phone       String
  startHour   Int            @default(10) @map("start_hour")
  endHour     Int            @default(20) @map("end_hour")
  rooms       Room[]
  materials   Material[]
  movements   StockMovement[]
  sterCycles  SterCycle[]
  orders      PurchaseOrder[]
  createdAt   DateTime       @default(now()) @db.Timestamptz
  updatedAt   DateTime       @updatedAt @db.Timestamptz

  @@map("sites")
}

model Room {
  id           String        @id @default(uuid()) @db.Uuid
  siteId       String        @map("site_id") @db.Uuid
  site         Site          @relation(fields: [siteId], references: [id])
  name         String
  appointments Appointment[]
  createdAt    DateTime      @default(now()) @db.Timestamptz
  updatedAt    DateTime      @updatedAt @db.Timestamptz

  @@map("rooms")
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  companyId    String        @map("company_id") @db.Uuid
  company      Company       @relation(fields: [companyId], references: [id])
  name         String
  email        String        @unique
  passwordHash String        @map("password_hash")
  role         Role
  appointments Appointment[]
  visits       Visit[]
  createdAt    DateTime      @default(now()) @db.Timestamptz
  updatedAt    DateTime      @updatedAt @db.Timestamptz

  @@map("users")
}

model Patient {
  id                  String            @id @default(uuid()) @db.Uuid
  companyId           String            @map("company_id") @db.Uuid
  company             Company           @relation(fields: [companyId], references: [id])
  name                String
  birthDate           DateTime          @map("birth_date") @db.Date
  /// alkalmazás szintű mezőtitkosítással tárolva (spec 9.)
  tajEncrypted        String?           @map("taj_encrypted")
  phone               String
  email               String?
  address             String?
  /// mindig látható, a PDF-re is rákerül (spec 2.1.3)
  healthWarning       String?           @map("health_warning")
  /// adminisztratív, alapból rejtett, nem nyomtatódik
  internalNote        String?           @map("internal_note")
  needsBuffer         Boolean           @default(false) @map("needs_buffer")
  dentition           Dentition         @default(permanent)
  dentitionChangedAt  DateTime?         @map("dentition_changed_at") @db.Timestamptz
  remindSms           Boolean           @default(true) @map("remind_sms")
  remindEmail         Boolean           @default(false) @map("remind_email")
  consents            Json?
  appointments        Appointment[]
  visits              Visit[]
  statuses            DentalStatus[]
  documents           Document[]
  diagnoses           Diagnosis[]
  treatmentPlans      TreatmentPlan[]
  events              AttendanceEvent[]
  recallInvites       RecallInvite[]
  recallSnoozes       RecallSnooze[]
  suggestions         Suggestion[]
  consentForms        ConsentForm[]
  invoices            Invoice[]
  createdAt           DateTime          @default(now()) @db.Timestamptz
  updatedAt           DateTime          @updatedAt @db.Timestamptz
  deletedAt           DateTime?         @map("deleted_at") @db.Timestamptz

  @@index([companyId, name])
  @@map("patients")
}

model TreatmentType {
  id           String          @id @default(uuid()) @db.Uuid
  code         String          @unique
  name         String
  durationMin  Int             @map("duration_min")
  bufferMin    Int             @default(0) @map("buffer_min")
  price        Int             @default(0)
  /// [1 felszín, 2 felszín, 3+ felszín] díja
  priceBySurf  Int[]           @map("price_by_surf")
  needsSurface Boolean         @default(false) @map("needs_surface")
  keywords     String[]
  notAfter     String[]        @map("not_after")
  color        String
  statusAfter  String?         @map("status_after")
  /// kontroll-meghívó ennyi hónap múlva (v2.0, 2.4)
  recallMonths Int?            @map("recall_months")
  /// beleegyező nyilatkozat sablonja (v2.0, 2.6)
  consentTpl   String?         @map("consent_tpl")
  packageLines PackageLine[]
  createdAt    DateTime        @default(now()) @db.Timestamptz
  updatedAt    DateTime        @updatedAt @db.Timestamptz

  @@map("treatment_types")
}

model PackageLine {
  id         String        @id @default(uuid()) @db.Uuid
  typeId     String        @map("type_id") @db.Uuid
  type       TreatmentType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  materialId String        @map("material_id") @db.Uuid
  material   Material      @relation(fields: [materialId], references: [id])
  qty        Decimal       @db.Decimal(10, 2)
  per        PerMode

  @@map("package_lines")
}

model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  patientId      String            @map("patient_id") @db.Uuid
  patient        Patient           @relation(fields: [patientId], references: [id])
  doctorId       String            @map("doctor_id") @db.Uuid
  doctor         User              @relation(fields: [doctorId], references: [id])
  roomId         String            @map("room_id") @db.Uuid
  room           Room              @relation(fields: [roomId], references: [id])
  startsAt       DateTime          @map("starts_at") @db.Timestamptz
  durationMin    Int               @map("duration_min")
  bufferMin      Int               @default(0) @map("buffer_min")
  typeCodes      String[]          @map("type_codes")
  /// tervezett fogak és felszínek, pl. {"36":["M"]}
  planned        Json?
  note           String?
  status         AppointmentStatus @default(booked)
  lateMin        Int?              @map("late_min")
  /// a páciens „NEM” válasza: csak jelzés az asszisztensnek, nincs automatikus lemondás (v2.1, 9. pont)
  cancelSignalAt   DateTime?         @map("cancel_signal_at") @db.Timestamptz
  cancelSignalText String?           @map("cancel_signal_text")
  /// előjegyzett tételek: [{"tooth":36,"typeCode":"tomes","surfaces":["M"]}] (v2.1, 2. pont)
  plannedItems   Json?             @map("planned_items")
  reminders      Reminder[]
  visit          Visit?
  createdAt      DateTime          @default(now()) @db.Timestamptz
  updatedAt      DateTime          @updatedAt @db.Timestamptz

  @@index([doctorId, startsAt])
  @@index([roomId, startsAt])
  @@map("appointments")
}

model Visit {
  id            String          @id @default(uuid()) @db.Uuid
  patientId     String          @map("patient_id") @db.Uuid
  patient       Patient         @relation(fields: [patientId], references: [id])
  appointmentId String?         @unique @map("appointment_id") @db.Uuid
  appointment   Appointment?    @relation(fields: [appointmentId], references: [id])
  doctorId      String          @map("doctor_id") @db.Uuid
  doctor        User            @relation(fields: [doctorId], references: [id])
  performedAt   DateTime        @map("performed_at") @db.Timestamptz
  typeCodes     String[]        @map("type_codes")
  /// nyers diktálás
  rawDictation  String?         @map("raw_dictation")
  /// jóváhagyott kartotékbejegyzés
  approvedText  String?         @map("approved_text")
  extended      Boolean         @default(false)
  fee           Int             @default(0)
  approvedAt    DateTime?       @map("approved_at") @db.Timestamptz
  /// a használt műszercsomag sterilizálási tétele (v2.0, 2.5)
  sterBatch     String?         @map("ster_batch")
  /// EESZT-jelentés (v2.0, 2.8)
  eesztStatus   String?         @map("eeszt_status")
  eesztRef      String?         @map("eeszt_ref")
  eesztSentAt   DateTime?       @map("eeszt_sent_at") @db.Timestamptz
  /// közérthető páciens-tájékoztató: csak orvosi jóváhagyás után küldhető (v2.0, 2.7)
  infoText      String?         @map("info_text")
  infoStatus    String?         @map("info_status")
  infoApprovedById String?      @map("info_approved_by_id") @db.Uuid
  infoApprovedAt DateTime?      @map("info_approved_at") @db.Timestamptz
  infoSentAt    DateTime?       @map("info_sent_at") @db.Timestamptz
  toothRecords  ToothRecord[]
  items         VisitItem[]
  /// utólagos módosítások naplója (v2.1, 13. pont)
  editLog       Json?           @map("edit_log")
  materials     VisitMaterial[]
  documents     Document[]
  createdAt     DateTime        @default(now()) @db.Timestamptz
  updatedAt     DateTime        @updatedAt @db.Timestamptz
  deletedAt     DateTime?       @map("deleted_at") @db.Timestamptz

  @@map("visits")
}

/// kezelési tétel egy vizitben: egy fog + egy művelet (v2.1, 2. pont)
model VisitItem {
  id        String   @id @default(uuid()) @db.Uuid
  visitId   String   @map("visit_id") @db.Uuid
  visit     Visit    @relation(fields: [visitId], references: [id])
  /// FDI-szám; fog nélküli műveletnél (pl. állapotfelmérés) üres
  tooth     Int?
  typeCode  String   @map("type_code")
  surfaces  String[]
  /// planned (előjegyzett) | added (kezelés közben hozzáadott) | manual
  origin    String
  /// done | postponed
  state     String
  fee       Int      @default(0)
  note      String?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([visitId])
  @@map("visit_items")
}

model ToothRecord {
  id               String   @id @default(uuid()) @db.Uuid
  visitId          String   @map("visit_id") @db.Uuid
  visit            Visit    @relation(fields: [visitId], references: [id])
  /// FDI: 11–48, tejfogaknál 51–85
  tooth            Int
  plannedSurfaces  String[] @map("planned_surfaces")
  treatedSurfaces  String[] @map("treated_surfaces")
  state            String?
  typeCode         String?  @map("type_code")
  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @updatedAt @db.Timestamptz

  @@map("tooth_records")
}

model DentalStatus {
  id         String    @id @default(uuid()) @db.Uuid
  patientId  String    @map("patient_id") @db.Uuid
  patient    Patient   @relation(fields: [patientId], references: [id])
  takenAt    DateTime  @map("taken_at") @db.Timestamptz
  dentition  Dentition
  /// fogankénti állapotok, pl. {"16":["hianyzik"],"46":["gyokerkezelt","korona"]}
  teeth      Json
  note       String?
  /// státuszfelvétel | dictation (kezelés közben diktált változás, v2.1, 4. pont)
  source     String?
  /// a változások: {"36":{"from":["ep"],"to":["tomott"]}}
  changes    Json?
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @updatedAt @db.Timestamptz

  @@map("dental_statuses")
}

model Diagnosis {
  id        String    @id @default(uuid()) @db.Uuid
  patientId String    @map("patient_id") @db.Uuid
  patient   Patient   @relation(fields: [patientId], references: [id])
  text      String
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@map("diagnoses")
}

model TreatmentPlan {
  id        String    @id @default(uuid()) @db.Uuid
  patientId String    @map("patient_id") @db.Uuid
  patient   Patient   @relation(fields: [patientId], references: [id])
  text      String
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@map("treatment_plans")
}

model Document {
  id         String    @id @default(uuid()) @db.Uuid
  patientId  String    @map("patient_id") @db.Uuid
  patient    Patient   @relation(fields: [patientId], references: [id])
  visitId    String?   @map("visit_id") @db.Uuid
  visit      Visit?    @relation(fields: [visitId], references: [id])
  docType    String    @map("doc_type")
  fileName   String    @map("file_name")
  mime       String
  size       Int
  /// a fájl titkosítva a tárolóban, itt csak a hivatkozás (a tárolás helye nyitott kérdés)
  storageKey String    @map("storage_key")
  note       String?
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @updatedAt @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  @@map("documents")
}

model Supplier {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  phone     String?
  email     String?
  materials Material[]
  createdAt DateTime   @default(now()) @db.Timestamptz
  updatedAt DateTime   @updatedAt @db.Timestamptz

  @@map("suppliers")
}

model Material {
  id           String          @id @default(uuid()) @db.Uuid
  siteId       String          @map("site_id") @db.Uuid
  site         Site            @relation(fields: [siteId], references: [id])
  code         String
  category     String
  name         String
  unit         String
  targetQty    Decimal         @map("target_qty") @db.Decimal(10, 2)
  /// alacsony készlet küszöb a célkészlet arányában (alapértelmezés 10%)
  threshold    Decimal         @default(0.1) @db.Decimal(4, 3)
  leadDays     Int             @map("lead_days")
  /// gördülő súlyozott átlagár (v2.0, 2.3.3)
  avgPrice     Decimal         @default(0) @map("avg_price") @db.Decimal(12, 2)
  lastPrice    Decimal?        @map("last_price") @db.Decimal(12, 2)
  /// biztonsági tartalék (v2.1, 10. pont): qty = mennyiség, weeks = a heti fogyás többszöröse
  safetyMode   String?         @map("safety_mode")
  safetyValue  Decimal?        @map("safety_value") @db.Decimal(10, 2)
  lotTracked   Boolean         @default(false) @map("lot_tracked")
  implant      Boolean         @default(false)
  lots         Lot[]
  orderLines   PurchaseOrderLine[]
  expiresAt    DateTime?       @map("expires_at") @db.Date
  keywords     String[]
  generic      Boolean         @default(false)
  supplierId   String?         @map("supplier_id") @db.Uuid
  supplier     Supplier?       @relation(fields: [supplierId], references: [id])
  packageLines PackageLine[]
  usages       VisitMaterial[]
  movements    StockMovement[]
  createdAt    DateTime        @default(now()) @db.Timestamptz
  updatedAt    DateTime        @updatedAt @db.Timestamptz

  @@unique([siteId, code])
  @@map("materials")
}

model VisitMaterial {
  id         String   @id @default(uuid()) @db.Uuid
  visitId    String   @map("visit_id") @db.Uuid
  visit      Visit    @relation(fields: [visitId], references: [id])
  materialId String   @map("material_id") @db.Uuid
  material   Material @relation(fields: [materialId], references: [id])
  qty        Decimal  @db.Decimal(10, 2)
  /// felhasznált gyártási tételek [{lot, expiry, qty}] és az anyagköltség átlagáron
  lots       Json?
  cost       Decimal? @db.Decimal(12, 2)

  @@map("visit_materials")
}

/// a készlet a mozgásokból számolható; a visit jóváhagyásakor felhasználás keletkezik
model StockMovement {
  id         String       @id @default(uuid()) @db.Uuid
  siteId     String       @map("site_id") @db.Uuid
  site       Site         @relation(fields: [siteId], references: [id])
  materialId String       @map("material_id") @db.Uuid
  material   Material     @relation(fields: [materialId], references: [id])
  kind       MovementKind
  qty        Decimal      @db.Decimal(10, 2)
  visitId    String?      @map("visit_id") @db.Uuid
  note       String?
  unitPrice  Decimal?     @map("unit_price") @db.Decimal(12, 2)
  avgAfter   Decimal?     @map("avg_after") @db.Decimal(12, 2)
  lotId      String?      @map("lot_id") @db.Uuid
  lots       Json?
  occurredAt DateTime     @map("occurred_at") @db.Timestamptz
  createdAt  DateTime     @default(now()) @db.Timestamptz

  @@index([materialId, occurredAt])
  @@map("stock_movements")
}

model Reminder {
  id            String          @id @default(uuid()) @db.Uuid
  appointmentId String          @map("appointment_id") @db.Uuid
  appointment   Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  channel       ReminderChannel
  sendAt        DateTime        @map("send_at") @db.Timestamptz
  sentAt        DateTime?       @map("sent_at") @db.Timestamptz
  status        ReminderStatus  @default(scheduled)
  createdAt     DateTime        @default(now()) @db.Timestamptz
  updatedAt     DateTime        @updatedAt @db.Timestamptz

  @@map("reminders")
}

model AttendanceEvent {
  id        String   @id @default(uuid()) @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  patient   Patient  @relation(fields: [patientId], references: [id])
  kind      String
  lateMin   Int?     @map("late_min")
  occurredAt DateTime @map("occurred_at") @db.Timestamptz

  @@map("attendance_events")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  detail    Json?
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([entity, entityId])
  @@map("audit_log")
}

/* ---------- v2.0 ---------- */

/// gyártási tétel; a kiadás lejárat szerint (FEFO)
model Lot {
  id         String    @id @default(uuid()) @db.Uuid
  materialId String    @map("material_id") @db.Uuid
  material   Material  @relation(fields: [materialId], references: [id])
  lot        String
  expiry     DateTime? @db.Date
  qty        Decimal   @db.Decimal(10, 2)
  unitPrice  Decimal   @map("unit_price") @db.Decimal(12, 2)
  receivedAt DateTime  @map("received_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz

  @@index([materialId, expiry])
  @@index([lot])
  @@map("lots")
}

/// megrendelés: a program javasolja, munkatárs adja le
model PurchaseOrder {
  id         String              @id @default(uuid()) @db.Uuid
  siteId     String              @map("site_id") @db.Uuid
  site       Site                @relation(fields: [siteId], references: [id])
  supplier   String
  orderedBy  String              @map("ordered_by")
  status     String              @default("ordered")
  note       String?
  orderedAt  DateTime            @map("ordered_at") @db.Timestamptz
  /// v2.1, 11. pont: ordered | partial | received | closed | cancelled
  ref          String?
  expectedAt   DateTime?           @map("expected_at") @db.Date
  receivedAt   DateTime?           @map("received_at") @db.Date
  closedNote   String?             @map("closed_note")
  cancelReason String?             @map("cancel_reason")
  lines      PurchaseOrderLine[]
  createdAt  DateTime            @default(now()) @db.Timestamptz
  updatedAt  DateTime            @updatedAt @db.Timestamptz

  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id         String        @id @default(uuid()) @db.Uuid
  orderId    String        @map("order_id") @db.Uuid
  order      PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  materialId String        @map("material_id") @db.Uuid
  material   Material      @relation(fields: [materialId], references: [id])
  qty        Decimal       @db.Decimal(10, 2)
  receivedQty Decimal      @default(0) @map("received_qty") @db.Decimal(10, 2)

  @@map("purchase_order_lines")
}

/// sterilizációs napló – csak kiegészíthető, nem törölhető
model SterCycle {
  id        String   @id @default(uuid()) @db.Uuid
  siteId    String   @map("site_id") @db.Uuid
  site      Site     @relation(fields: [siteId], references: [id])
  batch     String   @unique
  startedAt DateTime @map("started_at") @db.Timestamptz
  device    String
  program   String
  operator  String
  packs     Int
  contents  String
  chemOk    Boolean  @map("chem_ok")
  bowieDick Boolean? @map("bowie_dick")
  bioOk     Boolean? @map("bio_ok")
  ok        Boolean
  note      String?
  createdAt DateTime @default(now()) @db.Timestamptz

  @@map("ster_cycles")
}

model RecallInvite {
  id        String   @id @default(uuid()) @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  patient   Patient  @relation(fields: [patientId], references: [id])
  typeCode  String   @map("type_code")
  channels  String[]
  sentAt    DateTime @map("sent_at") @db.Timestamptz

  @@map("recall_invites")
}

/// aláírt beleegyező nyilatkozat; a PDF a dokumentumok között
model ConsentForm {
  id         String   @id @default(uuid()) @db.Uuid
  patientId  String   @map("patient_id") @db.Uuid
  patient    Patient  @relation(fields: [patientId], references: [id])
  visitId    String?  @map("visit_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  typeCodes  String[] @map("type_codes")
  teeth      Int[]
  title      String
  text       String
  doctorId   String   @map("doctor_id") @db.Uuid
  signedAt   DateTime @map("signed_at") @db.Timestamptz

  @@map("consent_forms")
}

/// a számlázó programmal kiállított számla hivatkozása (a számlát a számlázó állítja ki)
model Invoice {
  id          String   @id @default(uuid()) @db.Uuid
  patientId   String   @map("patient_id") @db.Uuid
  patient     Patient  @relation(fields: [patientId], references: [id])
  number      String   @unique
  issuedAt    DateTime @map("issued_at") @db.Timestamptz
  payerName   String   @map("payer_name")
  payerAddress String? @map("payer_address")
  method      String
  fund        String?
  lines       Json
  total       Int
  provider    String?
  providerRef String?  @map("provider_ref")
  visitIds    String[] @map("visit_ids")

  @@map("invoices")
}

/// kontroll-felülvizsgálat: „nem szükséges” / „később” jelölés (v2.1, 8. pont)
model RecallSnooze {
  id        String    @id @default(uuid()) @db.Uuid
  patientId String    @map("patient_id") @db.Uuid
  patient   Patient   @relation(fields: [patientId], references: [id])
  typeCode  String    @map("type_code")
  /// az a legutóbbi kezelés (dátum), amelyre a jelölés vonatkozik
  lastDate  DateTime  @map("last_date") @db.Date
  /// null = nem szükséges
  until     DateTime? @db.Date
  reason    String?
  createdAt DateTime  @default(now()) @db.Timestamptz

  @@map("recall_snoozes")
}

/// javasolt, még be nem ütemezett kezelés – az asszisztens teendőlistája (v2.1, 12. pont)
model Suggestion {
  id            String    @id @default(uuid()) @db.Uuid
  patientId     String    @map("patient_id") @db.Uuid
  patient       Patient   @relation(fields: [patientId], references: [id])
  visitId       String?   @map("visit_id") @db.Uuid
  doctorId      String    @map("doctor_id") @db.Uuid
  tooth         Int?
  typeCode      String    @map("type_code")
  surfaces      String[]
  note          String?
  /// urgent | recommended | later
  urgency       String
  dueDate       DateTime? @map("due_date") @db.Date
  /// new | contacted | booked | done | postponed | declined | dropped
  status        String    @default("new")
  remindAt      DateTime? @map("remind_at") @db.Date
  appointmentId String?   @map("appointment_id") @db.Uuid
  callback      Boolean   @default(false)
  /// az „elvetve” állapotot csak orvos állíthatja be
  droppedById   String?   @map("dropped_by_id") @db.Uuid
  contacts      Json?
  closedNote    String?   @map("closed_note")
  createdAt     DateTime  @default(now()) @db.Timestamptz
  updatedAt     DateTime  @updatedAt @db.Timestamptz

  @@index([patientId, status])
  @@map("suggestions")
}

/// kódtáblák (v2.1, 5. pont): verziózott, szabványos kódkészletek; a diktálás értelmezése erre épül
model CodeSet {
  id        String   @id @default(uuid()) @db.Uuid
  /// tooth | surface | state | procedure | material
  kind      String
  code      String
  name      String
  latinName String?  @map("latin_name")
  extra     Json?
  version   String
  validFrom DateTime @map("valid_from") @db.Date
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz

  @@unique([kind, code, version])
  @@map("code_sets")
}

/// szinonimatábla: elhangzó forma → szabványos kifejezés (v2.1, 5. pont)
model Synonym {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id])
  fromTerm  String   @map("from_term")
  toTerm    String   @map("to_term")
  grp       String?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([companyId, fromTerm])
  @@map("synonyms")
}

/// kontroll- és javaslat-üzenetsablonok (v2.1, 8. pont) – admin szerkeszti
model MessageTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id])
  /// recall | suggestion | reminder
  kind      String
  name      String
  body      String
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("message_templates")
}
