{
  // Cloudflare: a Molio demó statikus oldalként települ (npx nuxt generate → .output/public)
  "name": "molio",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": ".output/public",
    "not_found_handling": "single-page-application"
  },
  // előnézeti (nem éles) ágak buildjéhez: `wrangler preview` ezt a blokkot várja
  "previews": {}
}
